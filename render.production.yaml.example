# Render Blueprint for Shopsoma Production Environment
# Copy this to render.yaml when ready for production
# NOTE: You'll need to create separate Render Blueprint for production

databases:
  # PostgreSQL Production Database
  - name: shopsoma-production-db
    plan: standard  # Paid plan for production (better performance, backups)
    region: oregon
    databaseName: shopsoma_production
    user: shopsoma_user
    ipAllowList: []  # Add IP restrictions if needed

services:

  # Backend API (FastAPI) - Production
  - type: web
    name: shopsoma-api
    env: python
    region: oregon
    plan: standard  # Paid plan for production
    branch: main  # Deploy from main branch
    buildCommand: "cd shopsoma-backend && pip install -r requirements.txt"
    startCommand: "cd shopsoma-backend && alembic upgrade heads && uvicorn app.main:app --host 0.0.0.0 --port $PORT --workers 4"
    envVars:
      - key: PYTHON_VERSION
        value: 3.9.18
      - key: DATABASE_URL
        fromDatabase:
          name: shopsoma-production-db
          property: connectionString
      - key: SECRET_KEY
        sync: false  # Set manually in Render dashboard - DO NOT auto-generate for production
      - key: ALGORITHM
        value: HS256
      - key: ACCESS_TOKEN_EXPIRE_MINUTES
        value: 30
      - key: REFRESH_TOKEN_EXPIRE_DAYS
        value: 7
      - key: ENVIRONMENT
        value: production
      - key: ALLOWED_ORIGINS
        value: https://shopsoma.com,https://www.shopsoma.com
      - key: DATABASE_ECHO
        value: false
      # Add additional production secrets manually in Render dashboard:
      # - SENTRY_DSN
      # - STRIPE_SECRET_KEY
      # - AWS_ACCESS_KEY_ID
      # - AWS_SECRET_ACCESS_KEY
      # - SENDGRID_API_KEY
    healthCheckPath: /api/v1/health
    autoDeploy: false  # Require manual approval for production deploys

  # Frontend (React + Vite) - Production
  - type: web
    name: shopsoma
    env: static
    branch: main  # Deploy from main branch
    buildCommand: "cd shopsoma-frontend && npm install && npm run build"
    staticPublishPath: shopsoma-frontend/dist
    routes:
      - type: rewrite
        source: /*
        destination: /index.html
    envVars:
      - key: VITE_API_BASE_URL
        value: https://api.shopsoma.com/api/v1  # Use custom domain
      - key: VITE_APP_NAME
        value: Shopsoma
      - key: VITE_ENVIRONMENT
        value: production
      # Add analytics/monitoring keys manually:
      # - VITE_GOOGLE_ANALYTICS_ID
      # - VITE_SENTRY_DSN
    pullRequestPreviewsEnabled: false  # Disable PR previews for production
    autoDeploy: false  # Require manual approval

# Production Setup Checklist:
#
# 1. Custom Domains (set in Render dashboard):
#    - Frontend: shopsoma.com, www.shopsoma.com
#    - API: api.shopsoma.com
#
# 2. SSL Certificates:
#    - Render provides free SSL via Let's Encrypt
#    - Custom certificates can be uploaded if needed
#
# 3. Database Backups:
#    - Enable automatic daily backups
#    - Set retention period (7-30 days)
#    - Test restore procedure
#
# 4. Monitoring:
#    - Set up uptime monitoring
#    - Configure error tracking (Sentry)
#    - Enable performance monitoring
#
# 5. Security:
#    - Enable IP allowlist for database if needed
#    - Rotate SECRET_KEY regularly
#    - Use strong passwords for database
#    - Enable 2FA for Render account
#
# 6. Scaling:
#    - Consider multiple instances for high availability
#    - Set up auto-scaling rules
#    - Configure CDN for static assets
#
# 7. Environment Variables:
#    - Set all secrets manually in Render dashboard
#    - Never commit secrets to git
#    - Use different secrets for staging vs production
