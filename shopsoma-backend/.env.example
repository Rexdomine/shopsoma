# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/shopsoma_db
DATABASE_ECHO=false
RENDER_DATABASE_URL=postgresql://user:password@host:5432/shopsoma_staging

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Paystack Configuration
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# Email Configuration
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@shopsoma.com

# Brevo Email Service
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=noreply@shopsoma.com
BREVO_SENDER_NAME=Shopsoma
FRONTEND_BASE_URL=http://localhost:5173

# ShipBubble Shipping Service
# Docs: https://docs.shipbubble.com
SHIPBUBBLE_API_KEY=sb_sandbox_your_test_api_key
SHIPBUBBLE_WEBHOOK_SECRET=your_webhook_secret

# S3/Object Storage Configuration
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=shopsoma-uploads
S3_ENDPOINT_URL=  # Optional: For CloudFlare R2 or MinIO
CDN_BASE_URL=  # Optional: CloudFront or CloudFlare CDN URL

# Image Processing
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
IMAGE_QUALITY=85
THUMBNAIL_SIZE=300,300
MEDIUM_SIZE=800,800
LARGE_SIZE=1600,1600

# Application Settings
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
API_PREFIX=/api/v1

# Commission Rate (percentage)
DEFAULT_COMMISSION_RATE=12.5
PAYOUT_HOLD_DAYS=14

# Admin Settings
ADMIN_EMAIL=admin@shopsoma.com

# Checkout capability fingerprinting / guest capability
CHECKOUT_CAPABILITY_ACTIVE_PEPPER=replace-with-random-secret
CHECKOUT_CAPABILITY_ACTIVE_PEPPER_VERSION=1
CHECKOUT_CAPABILITY_PREVIOUS_PEPPER=
CHECKOUT_CAPABILITY_PREVIOUS_PEPPER_VERSION=

# DHL sandbox shipment / rating
DHL_ENABLED=false
DHL_ENVIRONMENT=sandbox
DHL_API_USERNAME=
DHL_API_PASSWORD=
DHL_EXPORT_ACCOUNT_NUMBER=
DHL_IMPORT_ACCOUNT_NUMBER=
DHL_REQUEST_TIMEOUT_SECONDS=30
DHL_DOMESTIC_WORKFLOW_ENABLED=false
DHL_DOMESTIC_QUOTE_ENFORCEMENT_ENABLED=false
DHL_DOMESTIC_PROVIDER_CALLS_ENABLED=false
DHL_DOMESTIC_QUOTE_TTL_SECONDS=1800
DHL_DOMESTIC_SANDBOX_COHORT_IDS=

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
