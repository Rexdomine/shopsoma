# Application Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
FRONTEND_BASE_URL=http://localhost:5173

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/shopsoma_db
DATABASE_ECHO=false
RENDER_DATABASE_URL=postgresql://user:password@host:5432/shopsoma_staging

# JWT Configuration
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
ALLOWED_ORIGIN_REGEX=

# Sensitive endpoint rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
# Optional: only set this when the backend sits behind a proxy that rewrites
# X-Forwarded-For / X-Real-IP. Accepts comma-separated IPs or CIDR ranges.
# Leave empty to trust only the direct client socket IP.
TRUSTED_PROXY_IPS=

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Paystack Configuration
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Shopsoma

# Brevo Email Service
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@shopsoma.com
BREVO_SENDER_NAME=Shopsoma

# ShipBubble Shipping Service
SHIPBUBBLE_API_KEY=sb_sandbox_your_test_api_key
SHIPBUBBLE_WEBHOOK_SECRET=replace-with-shipbubble-webhook-secret

# DHL Express MyDHL API
# Keep disabled until the corresponding integration phase has passed sandbox QA.
DHL_ENABLED=false
# Allowed values: sandbox, production
DHL_ENVIRONMENT=sandbox
DHL_API_USERNAME=
DHL_API_PASSWORD=
DHL_EXPORT_ACCOUNT_NUMBER=
# Optional until an import-account shipment flow is approved.
DHL_IMPORT_ACCOUNT_NUMBER=
# Bounded by application validation to 1-60 seconds.
DHL_REQUEST_TIMEOUT_SECONDS=30

# Domestic DHL workflow safety gates. Keep all gates false until each rollout
# stage is explicitly approved. Provider calls also require configured DHL credentials.
DHL_DOMESTIC_WORKFLOW_ENABLED=false
DHL_DOMESTIC_QUOTE_ENFORCEMENT_ENABLED=false
DHL_DOMESTIC_PROVIDER_CALLS_ENABLED=false
# Separate customer-checkout activation gate; keep false during shadow/UAT phases.
DHL_DOMESTIC_CHECKOUT_ENABLED=false
# Canonical comma-separated UUIDs for approved synthetic sandbox cohorts only.
DHL_DOMESTIC_SANDBOX_COHORT_IDS=
# Application-enforced bounds: quote/payment 300-3600; auth grace 60-1800 seconds.
DHL_DOMESTIC_QUOTE_TTL_SECONDS=1800
DHL_DOMESTIC_PAYMENT_WINDOW_SECONDS=1800
DHL_DOMESTIC_AUTH_GRACE_SECONDS=900

# Storage Configuration
# Development default: omit USE_LOCAL_STORAGE to stay on local disk.
# Staging/production: set USE_LOCAL_STORAGE=false and provide object storage vars below.
USE_LOCAL_STORAGE=true
ALLOW_LOCAL_STORAGE_IN_NON_DEV=false
LOCAL_UPLOAD_DIR=uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
CDN_BASE_URL=

# Redis / Celery
# Current critical checkout and payment flows do not enqueue Celery jobs.
# Leave these empty unless you intentionally introduce worker-backed tasks.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Image Processing
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
IMAGE_QUALITY=85
THUMBNAIL_SIZE=300,300
MEDIUM_SIZE=800,800
LARGE_SIZE=1600,1600

# Business Settings
DEFAULT_COMMISSION_RATE=12.5
PAYOUT_HOLD_DAYS=14
PASSWORD_RESET_EXPIRE_MINUTES=60
DEFAULT_CURRENCY=NGN

# Admin Settings
ADMIN_EMAIL=admin@shopsoma.com

# Checkout capability fingerprinting / guest capability
CHECKOUT_CAPABILITY_ACTIVE_PEPPER=replace-with-random-secret
CHECKOUT_CAPABILITY_ACTIVE_PEPPER_VERSION=1
CHECKOUT_CAPABILITY_PREVIOUS_PEPPER=
CHECKOUT_CAPABILITY_PREVIOUS_PEPPER_VERSION=

